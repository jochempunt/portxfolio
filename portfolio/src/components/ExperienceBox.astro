---
import LightBox from "./LightBox.astro";

interface Props {
  title: string;
  description: string;
  organization: string;
  startDate: string;
  endDate?: string;
  links?: { label: string; href: string }[];
  img?: string;
}

const { title, description, organization, startDate, endDate, img, links = [] } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "short", year: "numeric", timeZone: "UTC",
});
const formatDate = (date: string) => dateFormatter.format(new Date(`${date}-01T00:00:00Z`));
---

<article class="item">
  <div class="content">
    <p class="year">
      <time datetime={startDate}>{formatDate(startDate)}</time>
      {" – "}
      {endDate ? <time datetime={endDate}>{formatDate(endDate)}</time> : "Present"}
    </p>
    <h3 class="title">{title}</h3>
    <p class="organization">{organization}</p>
    <p class="description">{description}</p>
    {links.length > 0 && (
      <ul class="experience-links" aria-label={`Links for ${title} at ${organization}`}>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    )}
  </div>
  {img && (
    <div class="experience-media">
      <LightBox src={img} alt={`Preview of ${title} at ${organization}`} size={320} />
    </div>
  )}
</article>

<style>
  .item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .content {
    flex: 1;
    min-width: 0;
  }

  .title {
    margin: 0 0 0.3rem;
    color: var(--text-color-light);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .year {
    margin: 0 0 0.35rem;
    color: var(--text-color);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .description {
    margin: 0;
    color: var(--text-color);
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .organization {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--text-color);
  }

  .experience-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9rem;
    color: var(--text-color-light);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .experience-links a:hover {
    color: var(--accent-color);
  }

  .experience-media {
    flex: 0 0 160px;
    width: 160px;
  }

  .experience-media :global(.img-trigger) {
    width: 100%;
  }

  .experience-media :global(.img-trigger img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .item {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.85rem 0;
    }

    .experience-media {
      flex: none;
      width: min(100%, 14rem);
    }
  }
</style>
