---
import BasicLayout from "../layouts/basicLayout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import { getCollection } from "astro:content";
const description =
  "Interactive web apps, game prototypes & research projects by Jochem Punt - a software engineer specializing in UX, frontend & 3D development";
const projects = await getCollection("projects");
---

<BasicLayout
  title="Jochem Punt - Web, Game & UX Development Projects"
  id="projects"
  description={description}
>
  <section id="info">
    <h1>Projects by Jochem Punt</h1>
    <p class="tagline">Software Development • UX • Frontend • 3D • Games</p>
    <p>
      Explore interactive web applications, game prototypes, and research
      projects showcasing expertise in UX design, frontend development, and 3D
      experiences.
      <a id="more" href="/about-me/">Learn more about me</a>
    </p>
  </section>


<section class="projects-list">
  {
    projects
      .sort((a, b) => a.data.prio - b.data.prio)
      .map((proj) => (
        <ProjectPreview
          title={proj.data.title}
          slug={proj.id}
          description={proj.data.description}
          img={proj.data.img}
          tags={proj.data.tags}
          github={proj.data.github}
        />
      ))
  }
</section>

</BasicLayout>


<style>
  .projects-list {
    max-width: 900px;
    margin: 0 auto;
    padding-bottom: 3rem;
  }
  main {
    max-width: 900px;
  }

  #info {
    margin-bottom: 1rem;
  }

  .tagline {
    font-weight: 500;
    color: var(--text-color-light);
    font-size: 1.1rem;
  }
  #more {
    color: var(--accent-color);
    text-decoration: underline;
  }
  @media (max-width: 768px) {
    .projects-list {
      padding: 1rem;
    }

    #info {
      margin: 0 1rem;
    }
  }
</style>
