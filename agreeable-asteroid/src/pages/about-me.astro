---
import BasicLayout from "../layouts/basicLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";

const description =
"About Jochem Punt: frontend-focused software engineer building accessible, interactive interfaces and experiences.";
---

<BasicLayout title="About Jochem Punt" id="about-me" description={description}>
  <section class="intro">
    <h1>About me</h1>
    <p class="lead">
      I'm Jochem Punt, a frontend engineer based in the intersection of code and digital media.
      After a bachelor's in <i>Computer Science in Media</i> and a year working as a software engineer,
      I'm now heading into a master's in <i>Game and Media Technology</i>.
    </p>
    
    <p class="body">
      I like working across <strong>TypeScript</strong> (React, Astro), <strong>C#</strong> (.NET, Unity),
      and <strong>Python</strong>, building web apps and 3D experiences. I'm especially drawn to UX/IX
      and interactive design; 
      figuring out how something should feel to use, not just how it should work.
    </p>
  </section>
  
  <section class="connect">
    <h2>Get in touch</h2>
    <div class="button-group">
      <ButtonLink
      href="/linkedin"
      label="LinkedIn"
      icon="linkedin"
      />
      <ButtonLink
      href="https://github.com/jochempunt"
      label="GitHub"
      icon="github"
      />
      <ButtonLink
      email="jochem.punt@gmail.com"
      label="Email"
      />
    </div>
  </section>
</BasicLayout>

<style>
  section {
    margin-bottom: 2.5rem;
  }
  
  .lead {
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: var(--text-color-light);
    text-wrap-style:balance;
  }
  
  .body {
    line-height: 1.7;
    margin: 0;
    text-wrap-style:balance;
  }
  
  h2 {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--text-color-light);
    margin-bottom: 1rem;
  }
  
  strong {
    color: var(--text-color-light);
    font-weight: 600;
  }
  
  
  .button-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  @media (max-width: 768px) {
    section {
      margin-left: 1rem;
      margin-right: 1rem;
    }
  }
  
  @media (max-width: 500px) {
    .connect {
      margin-bottom: 3rem;
    }
    
    .button-group {
      flex-direction: column;
    }
  }
</style>